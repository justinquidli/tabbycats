{
  "name": "tabbycats",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "workers_dev": false,
  "preview_urls": false,
  // per-visitor limits: 10 sign-in starts and 60 posts/likes a minute
  // shared feeds for short links (tabbycats.party/f/<id>)
  "kv_namespaces": [{ "binding": "FEEDS", "id": "33c29da7d418463f8794c9bed96f6b98" }],
  "ratelimits": [
    { "name": "SIGNIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SUBMIT_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "SHARE_LIMIT", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "UNFURL_LIMIT", "namespace_id": "1004", "simple": { "limit": 300, "period": 60 } }
  ],
  "routes": [
    { "pattern": "tabbycats.party", "custom_domain": true },
    { "pattern": "www.tabbycats.party", "custom_domain": true },
    { "pattern": "tabbycat.party", "custom_domain": true },
    { "pattern": "www.tabbycat.party", "custom_domain": true }
  ]
}
